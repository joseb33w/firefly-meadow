# Supabase connection (anon/publishable key — safe to expose in the browser).
# Populate these for local dev OR via GitHub Actions secrets for production builds.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: override the fireflies table name. Defaults to usr_nmexs7bytxq2_fireflies.
# VITE_FIREFLIES_TABLE=usr_nmexs7bytxq2_fireflies
